<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>foundry-compile</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageId>Foundry.Schema.Compiler</PackageId>
    <Version>1.0.0</Version>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <!-- Route and transition-id derivation are internal because they are a contract between the
         compiler's own emitters, not a public API. The tests still need to pin them: the manifest
         and the generated command must agree on a transition's id, and nothing else would catch
         them drifting apart. -->
    <InternalsVisibleTo Include="Foundry.Schema.Compiler.Tests" />
  </ItemGroup>

</Project>
