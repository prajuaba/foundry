  "Workflows": [
    {
      "Id": "order-fulfilment",
      "Name": "Order Fulfilment",
      "Entity": "Order",
      "Version": "2.0.0",
      "EffectiveDate": "2026-01-01T00:00:00Z",
      "ExpirationDate": "2030-01-01T00:00:00Z",
      "IsActive": true,
      "States": [
        {
          "Name": "Pending",
          "IsInitial": true,
          "IsFinal": false,
          "AllowedRoles": [
            "Customer",
            "Sales",
            "Admin"
          ]
        },
        {
          "Name": "Review",
          "IsInitial": false,
          "IsFinal": false,
          "AllowedRoles": [
            "Sales",
            "Admin"
          ]
        },
        {
          "Name": "Approved",
          "IsInitial": false,
          "IsFinal": false,
          "AllowedRoles": [
            "Admin"
          ]
        },
        {
          "Name": "Shipped",
          "IsInitial": false,
          "IsFinal": true,
          "AllowedRoles": [
            "Warehouse",
            "Admin"
          ]
        },
        {
          "Name": "Cancelled",
          "IsInitial": false,
          "IsFinal": true,
          "AllowedRoles": [
            "Admin"
          ]
        }
      ],
      "Transitions": [
        {
          "Id": "submit",
          "Name": "Submit for fulfilment",
          "FromState": "Pending",
          "ToState": "value-gate",
          "Trigger": "SubmitOrderForFulfilment",
          "RequiredRoles": [
            "Customer",
            "Sales",
            "Admin"
          ],
          "Conditions": [
            {
              "Property": "TotalAmount",
              "Operator": "GreaterThan",
              "Value": "0",
              "Source": "entity"
            }
          ]
        },
        {
          "Id": "approve-after-review",
          "Name": "Approve after review",
          "FromState": "Review",
          "ToState": "Approved",
          "Trigger": "ApproveReviewedOrder",
          "RequiredRoles": [
            "Admin"
          ],
          "Conditions": []
        },
        {
          "Id": "ship",
          "Name": "Ship the order",
          "FromState": "Approved",
          "ToState": "Shipped",
          "Trigger": "ShipOrder",
          "RequiredRoles": [
            "Warehouse",
            "Admin"
          ],
          "Conditions": []
        },
        {
          "Id": "cancel",
          "Name": "Cancel the order",
          "FromState": "Review",
          "ToState": "Cancelled",
          "Trigger": "CancelReviewedOrder",
          "RequiredRoles": [
            "Admin"
          ],
          "Conditions": []
        }
      ],
      "ChoiceNodes": [
        {
          "Id": "value-gate",
          "Name": "ValueGate",
          "DefaultState": "Approved",
          "Branches": [
            {
              "ToState": "Review",
              "Conditions": [
                {
                  "Property": "TotalAmount",
                  "Operator": "GreaterThan",
                  "Value": "10000",
                  "Source": "entity"
                }
              ]
            },
            {
              "ToState": "Cancelled",
              "Conditions": [
                {
                  "Property": "PaymentCardNumber",
                  "Operator": "Equals",
                  "Value": "",
                  "Source": "entity"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}