  "dtos": [
    {
      "name": "OrderSummary",
      "enableKafkaOutbox": true,
      "kafkaTopic": "order-summaries",
      "enableFileIO": true,
      "fileIOAllowedExtensions": [
        ".csv"
      ],
      "properties": [
        {
          "name": "OrderNumber",
          "type": "string",
          "sourceEntity": "Order",
          "sourceProperty": "OrderNumber",
          "isRequired": true,
          "attributes": [
            "Required"
          ]
        },
        {
          "name": "TotalAmount",
          "type": "decimal",
          "sourceEntity": "Order",
          "sourceProperty": "TotalAmount"
        },
        {
          "name": "Status",
          "type": "OrderStatus",
          "isEnum": true,
          "sourceEntity": "Order",
          "sourceProperty": "Status"
        },
        {
          "name": "CustomerEmail",
          "type": "string",
          "attributes": [
            "Email"
          ]
        }
      ],
      "description": "Summary data transfer object for customers"
    }
  ],
  "customEndpoints": [
    {
      "route": "/api/v1/orders/submit",
      "method": "POST",
      "operationType": "Insert",
      "targetEntity": "Order",
      "requestType": "SubmitOrderCommand",
      "roles": [
        "Customer",
        "Admin"
      ],
      "businessRules": [
        "SubmitOrderRule"
      ]
    },
    {
      "route": "/api/v1/orders/{id}/cancel",
      "method": "PUT",
      "operationType": "Update",
      "targetEntity": "Order",
      "requestType": "CancelOrderCommand",
      "roles": [
        "Admin",
        "Sales"
      ],
      "assignments": [
        {
          "entityProperty": "Status",
          "sourceValue": "NewStatus"
        }
      ]
    },
    {
      "route": "/api/v1/products/in-stock",
      "method": "GET",
      "operationType": "Query",
      "targetEntity": "Product",
      "requestType": "InStockProductsQuery",
      "roles": [
        "Admin",
        "Sales",
        "Warehouse"
      ],
      "filterField": "StockQuantity",
      "filterOperator": "GreaterThan",
      "filterSourceValue": "MinimumStock"
    }
  ],
  "workflows": [
    {
      "id": "order-fulfilment",
      "name": "Order Fulfilment",
      "entity": "Order",
      "version": "2.0.0",
      "effectiveDate": "2026-01-01T00:00:00Z",
      "expirationDate": "2030-01-01T00:00:00Z",
      "isActive": true,
      "states": [
        {
          "name": "Pending",
          "isInitial": true,
          "allowedRoles": [
            "Customer",
            "Sales",
            "Admin"
          ]
        },
        {
          "name": "Review",
          "allowedRoles": [
            "Sales",
            "Admin"
          ]
        },
        {
          "name": "Approved",
          "allowedRoles": [
            "Admin"
          ]
        },
        {
          "name": "Shipped",
          "isFinal": true,
          "allowedRoles": [
            "Warehouse",
            "Admin"
          ]
        },
        {
          "name": "Cancelled",
          "isFinal": true,
          "allowedRoles": [
            "Admin"
          ]
        }
      ],
      "choiceNodes": [
        {
          "id": "value-gate",
          "name": "ValueGate",
          "defaultState": "Approved",
          "branches": [
            {
              "id": "high-value",
              "condition": {
                "type": "Property",
                "property": "TotalAmount",
                "operator": "GreaterThan",
                "value": "10000",
                "source": "entity"
              },
              "targetState": "Review"
            },
            {
              "id": "no-payment-method",
              "condition": {
                "type": "Property",
                "property": "PaymentCardNumber",
                "operator": "Equals",
                "value": "",
                "source": "entity"
              },
              "targetState": "Cancelled"
            }
          ]
        }
      ],
      "transitions": [
        {
          "id": "submit",
          "name": "Submit for fulfilment",
          "fromState": "Pending",
          "toState": "value-gate",
          "trigger": "SubmitOrderForFulfilment",
          "requiredRoles": [
            "Customer",
            "Sales",
            "Admin"
          ],
          "conditions": [
            {
              "type": "Property",
              "property": "TotalAmount",
              "operator": "GreaterThan",
              "value": "0",
              "source": "entity"
            }
          ]
        },
        {
          "id": "approve-after-review",
          "name": "Approve after review",
          "fromState": "Review",
          "toState": "Approved",
          "trigger": "ApproveReviewedOrder",
          "requiredRoles": [
            "Admin"
          ],
          "actions": [
            {
              "type": "ExternalApi",
              "method": "POST",
              "url": "https://hooks.internal.example/order-approved",
              "headers": {
                "X-Source": "foundry-showcase"
              },
              "bodyTemplate": "{\"orderNumber\":\"{{OrderNumber}}\",\"amount\":\"{{TotalAmount}}\"}",
              "retryable": true,
              "compensateWith": {
                "type": "InternalApi",
                "requestType": "UndoOrderApprovalCommand",
                "payloadTemplate": "{\"orderNumber\":\"{{OrderNumber}}\"}"
              }
            }
          ]
        },
        {
          "id": "ship",
          "name": "Ship the order",
          "fromState": "Approved",
          "toState": "Shipped",
          "trigger": "ShipOrder",
          "requiredRoles": [
            "Warehouse",
            "Admin"
          ],
          "actions": [
            {
              "type": "InternalApi",
              "requestType": "OrderSummary",
              "payloadTemplate": "{\"orderNumber\":\"{{OrderNumber}}\"}",
              "retryable": false
            }
          ]
        },
        {
          "id": "cancel",
          "name": "Cancel the order",
          "fromState": "Review",
          "toState": "Cancelled",
          "trigger": "CancelReviewedOrder",
          "useCustomCommand": true,
          "requiredRoles": [
            "Admin"
          ]
        }
      ]
    }
  ],
  "connectors": [
    {
      "name": "PaymentGateway",
      "type": "REST",
      "baseUrl": "https://payments.example.com",
      "authType": "Bearer",
      "token": "${PAYMENT_GATEWAY_TOKEN}",
      "timeoutSeconds": 15,
      "maxRetries": 3
    },
    {
      "name": "LegacyInventory",
      "type": "SOAP",
      "baseUrl": "https://legacy.example.com/inventory.asmx",
      "authType": "Basic",
      "username": "showcase",
      "password": "${LEGACY_INVENTORY_PASSWORD}",
      "soapAction": "http://legacy.example.com/CheckStock",
      "timeoutSeconds": 30,
      "maxRetries": 2
    },
    {
      "name": "PartnerCatalog",
      "type": "GraphQL",
      "baseUrl": "https://partners.example.com/graphql",
      "authType": "ApiKey",
      "apiKey": "${PARTNER_CATALOG_KEY}",
      "apiKeyHeaderName": "X-Partner-Key",
      "timeoutSeconds": 20,
      "maxRetries": 1
    }
  ]
}
