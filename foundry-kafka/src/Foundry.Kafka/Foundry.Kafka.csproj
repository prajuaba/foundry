<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" />
  </ItemGroup>

  <!-- Acks parsing is an internal detail, tested directly rather than exposed publicly just to
       make it reachable. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Foundry.Kafka.Tests" />

    <!-- Foundry.IntegrationTests is the only project referencing both this and the compiler, so it
         is where the compiler's copy of the topic-naming rule is held to this one. -->
    <InternalsVisibleTo Include="Foundry.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../foundry-core/src/Foundry.Core/Foundry.Core.csproj" />
  </ItemGroup>

</Project>
