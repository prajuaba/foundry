<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Foundry.FileIO</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="ExcelDataReader" />
    <PackageReference Include="PDFsharp-MigraDoc" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\foundry-core\src\Foundry.Core\Foundry.Core.csproj" />
  </ItemGroup>

  <!-- DejaVu Sans, embedded so a PDF renders the same on a developer machine and in a container
       with no fonts installed. Unmodified, under the Bitstream Vera licence shipped beside it. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\DejaVuSans.ttf" LogicalName="Foundry.FileIO.Fonts.DejaVuSans.ttf" />
    <EmbeddedResource Include="Fonts\DejaVuSans-Bold.ttf" LogicalName="Foundry.FileIO.Fonts.DejaVuSans-Bold.ttf" />
    <None Include="Fonts\DejaVu-LICENSE.txt" Pack="true" PackagePath="licenses" />
  </ItemGroup>

  <!-- TryConvert is where the cell-conversion defect lived; tested directly rather than made public. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Foundry.FileIO.Tests" />
  </ItemGroup>

</Project>
