<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>foundry</AssemblyName>
    <RootNamespace>Foundry.Cli</RootNamespace>

    <!-- Single file, but neither self-contained nor compressed *here*.

         Three settings have to agree and each breaks a different consumer if it does not:

           PublishSingleFile      stays. scripts/build-distro.sh publishes to dist-bin/ and CI
                                  uploads exactly one path from it, dist-bin/foundry. Without this
                                  the publish spreads across a directory and that single uploaded
                                  file is a bare apphost of 78 KB that cannot run, because
                                  foundry.dll and every dependency were left behind. The build
                                  still passes, because it verifies the binary where its
                                  dependencies are; only the artifact anyone downloads is broken.

           PublishSelfContained   removed. It does not flow to referenced projects, and
                                  Foundry.Schema.Compiler is a non-self-contained Exe with a
                                  documented standalone entry point, so a plain `dotnet publish`
                                  fails NETSDK1150. build-distro.sh passes SelfContained=true as a
                                  *global* property instead, which is what makes the whole project
                                  graph agree.

           EnableCompressionInSingleFile  removed. It requires self-contained, so with the line
                                  above gone a plain publish failed NETSDK1176. The two settings
                                  contradicted each other and publish worked in no configuration
                                  at all.

         So: `dotnet publish` produces a framework-dependent single file, build-distro.sh produces
         a self-contained one, and `dotnet pack` produces the tool package. All three are exercised
         below and none of them silently ships a binary that cannot start. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- Stated rather than left to inference. PublishSingleFile makes the SDK infer self-contained,
         which brings NETSDK1150 straight back for a plain `dotnet publish`. build-distro.sh passes
         SelfContained=true as a global property, and a global property beats a project one, so the
         distro build still produces the standalone binary CI uploads. -->
    <SelfContained>false</SelfContained>

    <!-- Shipped as a .NET tool as well. See docs/modules/foundry-cli.md for the install commands.
         Directory.Build.props disables packing repository-wide; the CLI is the one project meant
         to leave it, so it opts back in. -->
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>foundry</ToolCommandName>
    <PackageId>Foundry.Cli</PackageId>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../../artifacts/tool</PackageOutputPath>
  </PropertyGroup>

  <!-- Embed Studio IDE Web UI Singlefile Asset.

       dist/ is a build artifact and is deliberately not committed, so on a fresh clone
       this file does not exist yet. Embedding it unconditionally made the whole solution
       unbuildable until someone had run the Studio build, which is not a discoverable
       prerequisite. It is conditional instead, and the `foundry studio` command reports
       the missing asset with the command that produces it. -->
  <PropertyGroup>
    <StudioBundlePath>$(MSBuildThisFileDirectory)../../../foundry-studio/dist/index.html</StudioBundlePath>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(StudioBundlePath)')">
    <EmbeddedResource Include="$(StudioBundlePath)" Link="Resources/index.html" />
  </ItemGroup>

  <!-- Warn rather than fail: every other command works without the Studio bundle. -->
  <Target Name="WarnOnMissingStudioBundle" BeforeTargets="CoreCompile" Condition="!Exists('$(StudioBundlePath)')">
    <Warning Text="Studio UI bundle not found at $(StudioBundlePath) - the 'foundry studio' command will be unavailable in this build. Run 'npm ci &amp;&amp; npm run build' in foundry-studio to include it." />
  </Target>

  <!-- Include Core Foundry Framework Engines -->
  <ItemGroup>
    <ProjectReference Include="../../../foundry-core/src/Foundry.Core/Foundry.Core.csproj" />
    <ProjectReference Include="../../../foundry-schema/compiler/Foundry.Schema.Compiler.csproj" />
    <ProjectReference Include="../../../foundry-mongo/src/Foundry.Mongo/Foundry.Mongo.csproj" />
    <ProjectReference Include="../../../foundry-api/src/Foundry.Api/Foundry.Api.csproj" />
    <ProjectReference Include="../../../foundry-rules/src/Foundry.Rules/Foundry.Rules.csproj" />
    <ProjectReference Include="../../../foundry-file-io/src/Foundry.FileIO/Foundry.FileIO.csproj" />
    <ProjectReference Include="../../../foundry-realtime/src/Foundry.RealTime/Foundry.RealTime.csproj" />
    <ProjectReference Include="../../../foundry-kafka/src/Foundry.Kafka/Foundry.Kafka.csproj" />
    <ProjectReference Include="../../../foundry-testing/src/Foundry.Testing/Foundry.Testing.csproj" />
    <ProjectReference Include="../../../foundry-connectors/src/Foundry.Connectors/Foundry.Connectors.csproj" />
  </ItemGroup>

  <!-- JWT token signing for the 'token mint' command -->
  <ItemGroup>
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
  </ItemGroup>
</Project>
