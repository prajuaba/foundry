<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Foundry.Cli is referenced to ensure its dependencies (the framework assemblies) are
       available for reflection discovery. The tests invoke the CLI as a subprocess for exit code
       testing, but referencing it ensures the framework assemblies are loaded into the test process. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Foundry.Cli/Foundry.Cli.csproj"
                      ReferenceOutputAssembly="true"
                      SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

</Project>
